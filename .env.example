# Khóa sandbox CÔNG KHAI trong tài liệu MoMo (test-payment.momo.vn).
# Không điền khóa doanh nghiệp thật vào git. Đổi các giá trị này trên môi trường deploy.
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# Giá mẫu, đơn vị đồng. Server là nơi quyết định số tiền, client không được gửi giá.
PREMIUM_PRICE_MONTH=49000
PREMIUM_PRICE_YEAR=399000

# URL công khai để MoMo gọi IPN và redirect. Localhost không nhận được IPN từ MoMo.
PUBLIC_BASE_URL=http://127.0.0.1:43123

# Tài khoản NHẬN TIỀN MẪU. Đổi thành số thật trước khi bật VietQR / chuyển khoản.
BANK_BIN=970422
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_NAME=NGUOI DUNG MAU
BANK_NAME=Ngan hang mau

# Bí mật webhook Casso/SePay (header x-bank-secret hoặc Authorization: Apikey ...).
BANK_WEBHOOK_SECRET=doi-bi-mat-webhook

# Duyệt tay đơn chuyển khoản. Header: Authorization: Bearer <token>
ADMIN_TOKEN=doi-token-admin

# SQLite local. Trên serverless hãy trỏ sang adapter Postgres/KV (xem docs/THANH-TOAN.md).
PREMIUM_DB_PATH=data/premium.sqlite

# 1 thì bật cờ khóa nội dung. Mặc định tắt: mọi tờ hiện có vẫn mở.
PREMIUM_LOCK=0
VITE_PREMIUM_LOCK=0

# Ví nhận crypto MẪU. Không phải ví có người giữ khóa. Đổi trước khi nhận USDT/USDC.
# Server chỉ cần địa chỉ để đối soát. Không bao giờ điền khóa riêng hay cụm từ bí mật.
CRYPTO_TRON_ADDRESS=T9yD14Nj9j7xAB4dbGeiX9h92rXVpP4zzx
CRYPTO_BSC_ADDRESS=0x0000000000000000000000000000000000ba7010
CRYPTO_SOL_ADDRESS=11111111111111111111111111111111

# Tỷ giá dự phòng: đồng cho 1 USD. Để trống CRYPTO_RATE_URL nếu không muốn gọi mạng.
CRYPTO_VND_PER_USD=25000
CRYPTO_RATE_URL=https://api.frankfurter.app/latest?from=USD&to=VND

# RPC/API công khai. Đổi sang nút của bạn khi nhận tiền thật.
CRYPTO_TRON_API=https://api.trongrid.io
CRYPTO_BSC_RPC=https://bsc-dataseed.binance.org
CRYPTO_SOL_RPC=https://api.mainnet-beta.solana.com
CRYPTO_TRON_CONFIRMATIONS=19
CRYPTO_BSC_CONFIRMATIONS=15
CRYPTO_SOL_CONFIRMATIONS=32
CRYPTO_SOL_REQUIRE_FINALIZED=1
